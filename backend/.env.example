# Copy to backend/.env and fill in. backend/.env is gitignored.
#
# Required for LLM-first drafting in the Review Pipeline. Without
# OPENAI_API_KEY set, the deterministic template fallback is used.
OPENAI_API_KEY=sk-...

# Strongly recommended: point at the strongest reasoning model your
# account can access. The Review Pipeline asks the model to produce a
# full finite-state model + safety properties as strict JSON in one
# pass; smaller models routinely under-model environment transitions.
ASSURANCE_LLM_MODEL=gpt-4o

# Comma-separated CORS origins. Add the host the frontend is served
# from in dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-query Z3 timeout (ms). Timeouts are surfaced as a distinct
# outcome — never silently folded into pass.
ASSURANCE_SOLVER_TIMEOUT_MS=5000
